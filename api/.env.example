# Example configuration for local development.
#
# Copy to .env for local use. .env is gitignored.
# Values below are local placeholders. Replace them before sharing a machine.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

PGHOST=localhost
PGPORT=5432
PGDATABASE=agribridge
PGUSER=agribridge
PGPASSWORD=local-development-only
PG_POOL_MAX=10

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
CACHE_TTL_SECONDS=30

# Required when NODE_ENV=production. Development starts without it.
JWT_SECRET=local-development-signing-secret-only
BCRYPT_ROUNDS=8

RUN_MIGRATIONS=true
SEED_DEMO_DATA=true
SEED_PASSWORD=local-demo-password-only
TRUST_PROXY=true

# Injected at image build time. Leave unset when running from a checkout.
# GIT_SHA=
# APP_VERSION=
# IMAGE_TAG=
