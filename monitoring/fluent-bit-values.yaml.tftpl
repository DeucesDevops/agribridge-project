serviceAccount:
  name: fluent-bit
  annotations:
    eks.amazonaws.com/role-arn: "${role}"
config:
  inputs: |
    [INPUT]
        Name tail
        Path /var/log/containers/agribridge-*.log
        multiline.parser docker, cri
        Tag kube.*
        Mem_Buf_Limit 5MB
        Skip_Long_Lines On
  filters: |
    [FILTER]
        Name kubernetes
        Match kube.*
        Merge_Log On
        Keep_Log Off
  outputs: |
    [OUTPUT]
        Name cloudwatch_logs
        Match *
        region ${region}
        log_group_name /agribridge/containers
        log_stream_prefix k8s-
        auto_create_group false
